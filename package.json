{
  "name": "file2md",
  "version": "2.0.1",
  "description": "A TypeScript library for converting various document types (PDF, DOCX, XLSX, PPTX, HWP, HWPX) into Markdown with image and layout preservation",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/publish.js",
    "release:dry": "node scripts/publish.js --dry-run",
    "release:retry": "node scripts/publish.js --skip-increment",
    "version:increment": "node scripts/increment-version.js",
    "auth:check": "node scripts/setup-auth.js",
    "prepare": "husky"
  },
  "keywords": [
    "markdown",
    "converter",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "hwp",
    "hwpx",
    "korean",
    "hangul",
    "document",
    "typescript",
    "layout-preservation",
    "image-extraction"
  ],
  "author": "Ricky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricky-clevi/file2md.git"
  },
  "bugs": {
    "url": "https://github.com/ricky-clevi/file2md/issues"
  },
  "homepage": "https://github.com/ricky-clevi/file2md#readme",
  "dependencies": {
    "hwp.js": "^0.0.3",
    "jszip": "^3.10.1",
    "sax": "^1.6.1",
    "sharp": "^0.35.4",
    "unpdf": "~1.7.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/sax": "^1.2.7",
    "eslint": "^9.32.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.6",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.39.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "module": "dist/index.js"
}
